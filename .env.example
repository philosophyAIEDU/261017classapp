# ─────────────────────────────────────────────
# 이 파일을 복사해서 .env 라는 이름으로 저장하세요.
# (.env 는 GitHub에 올라가지 않습니다)
# ─────────────────────────────────────────────

# 데이터 저장 위치: local(이 컴퓨터 브라우저) | firebase(온라인 DB, 3단계)
VITE_DATA_MODE=local

# AI 종류: mock(샘플 AI, 무료·오프라인) | gemini(진짜 Gemini, 2단계)
VITE_AI_MODE=mock

# 데모 모드: true 이면 샘플 데이터 + "교사로 보기 / 학생으로 보기" 버튼이 나타납니다.
VITE_DEMO_MODE=true

# ─────────────────────────────────────────────
# (선택) 서버용 기본 Gemini 설정 — 2단계
# 보통은 비워 두고, 앱의 [선생님 화면 → AI 설정]에서 각자 API 키를 넣으면 됩니다.
# 여기에 키를 넣으면 "AI 설정"에 키가 없을 때 이 키를 대신 씁니다.
# ⚠️ 절대 VITE_ 로 시작하는 이름에 키를 넣지 마세요. (VITE_ 값은 누구나 볼 수 있는 화면 코드에 들어갑니다)
# ─────────────────────────────────────────────
# GEMINI_API_KEY=
# 첨삭 기본 모델 (gemini-3.8-flash | gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.8-flash
# 튜터 기본 모델
# GEMINI_TUTOR_MODEL=gemini-3.5-flash-lite

# ─────────────────────────────────────────────
# (3단계) Firebase — VITE_DATA_MODE=firebase 일 때 사용
# 설정값은 src/config/firebaseConfig.ts 에 들어 있어요. 다른 프로젝트를 쓸 때만 아래를 채우세요.
# ─────────────────────────────────────────────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# 서버 기본 키(GEMINI_API_KEY)를 쓸 수 있는 강사님 Google 이메일 (쉼표로 여러 명)
# TEACHER_EMAILS=

# (선택) 비밀번호 초기화용 서비스 계정 키 JSON — 절대 GitHub에 올리지 마세요
# FIREBASE_SERVICE_ACCOUNT=
